# ============================================
# C2-App-053 AI Literature Review Assistant
# ============================================
# Copy to .env and fill in actual values
# NEVER commit .env to git!

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
POSTGRES_USER=c2user
POSTGRES_PASSWORD=c2pass
POSTGRES_DB=c2db
# Use asyncpg driver for SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://c2user:c2pass@postgres:5432/c2db
# For local dev (outside docker): postgresql+asyncpg://c2user:c2pass@localhost:5432/c2db

# ---- Auth / JWT ----
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Graph Database (Neo4j) — used from Epic 4 ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# ---- Graph Sync settings (Story 4.1) ----
# Lưu ý: MAX_SYNC_RETRIES và GC_RETENTION_DAYS do Admin cấu hình runtime qua System Settings
# (bảng system_settings, API /admin/settings) — KHÔNG đặt ở env. Chỉ batch_size là knob hạ tầng.
SYNC_OUTBOX_BATCH_SIZE=100

# ---- LLM (Gemini) — used from Epic 2+ ----
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- AI Hook Logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
